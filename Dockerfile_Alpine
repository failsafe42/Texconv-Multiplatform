# Building workflow for Alpine Linux.
#
# 1. Use this docker file to build the executable.
#    docker build -t texconv -f Dockerfile_Alpine ./
#
# 2. Run the built image.
#    docker run texconv
#
# 3. Use "docker cp" to get the built executables.
#    docker cp <CONTAINER ID>:/Texconv-Multiplatform/texconv ./
#    docker cp <CONTAINER ID>:/Texconv-Multiplatform/texassemble ./
#
# 4. Also, you can get the built shared library.
#    docker cp <CONTAINER ID>:/Texconv-Multiplatform/libtexconv.so ./
#
# Notes:
#   -You can add JPEG and PNG support with build-arg
#    docker build --build-arg JPGPNG=true -t texconv -f Dockerfile_Alpine ./

# Base image
FROM alpine:3.16

# Add JPEG and PNG support when true
ARG JPGPNG=false

# Build and run tests
ARG TEST=false

# Install packages
RUN apk update && \
    apk add --no-cache musl-dev gcc make g++ file alpine-sdk wget bash && \
    if [ "$JPGPNG" = "true" ] || [ "$TEST" = "true" ]; then \
        apk add --no-cache libjpeg-turbo-dev libpng-dev nasm; \
    fi

# Clone repo
COPY . /Texconv-Multiplatform
WORKDIR /Texconv-Multiplatform
RUN git submodule update --init --recursive --recommend-shallow --depth 1

# Build
RUN if [ "$TEST" = "true" ]; then \
        ./build.cmd --test && \
        ./build.cmd --use-optional-formats --build-as-exe; \
    elif [ "$JPGPNG" = "true" ]; then \
        ./build.cmd --use-optional-formats && \
        ./build.cmd --use-optional-formats --build-as-exe; \
    else \
        ./build.cmd && \
        ./build.cmd --build-as-exe; \
    fi
